# Konfiguracja Caddy — automatyczny HTTPS (certyfikat Let's Encrypt).
# Domena ze zmiennej środowiskowej DOMAIN (z docker-compose/.env); DOMAIN=:80 = sieć
# lokalna bez HTTPS. Bez globalnego `email`: Let's Encrypt go nie wymaga, a pusta
# zmienna dawała błąd składni i restart Caddy w kółko.

{$DOMAIN} {
	# Przekazywanie ruchu do aplikacji Django (gunicorn) w kontenerze `web`.
	reverse_proxy web:8000

	# Kompresja odpowiedzi.
	encode zstd gzip
}
