# Skopiuj ten plik do `.env` (obok docker-compose.yml) i dostosuj wartości.
# Docker Compose automatycznie wczyta plik `.env`.

# --- Domena i HTTPS (Caddy) -------------------------------------------------
# Domena skierowana na publiczne IP serwera (rekord A w DNS).
# Caddy automatycznie pobierze i odnowi certyfikat HTTPS dla tej domeny.
DOMAIN=YOUR_DOMAIN_HERE
# Sieć lokalna bez domeny/HTTPS: DOMAIN=:80, DJANGO_SSL_REDIRECT=0, DJANGO_SECURE_COOKIES=0,
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1 — aplikacja pod http://localhost/.

# --- Bezpieczeństwo ---------------------------------------------------------
# Wygeneruj własny, długi losowy klucz (NIE zostawiaj domyślnego w produkcji!)
DJANGO_SECRET_KEY=YOUR_DJANGO_SECRET_KEY_HERE

# Host(y) pod którym działa aplikacja — zwykle Twoja domena.
DJANGO_ALLOWED_HOSTS=YOUR_DJANGO_ALLOWED_HOSTS_HERE

# Wymagane do logowania/formularzy przez HTTPS (Twoja domena z https://):
DJANGO_CSRF_TRUSTED_ORIGINS=YOUR_DJANGO_CSRF_TRUSTED_ORIGINS_HERE

# Bezpieczne ciasteczka i przekierowanie HTTP → HTTPS (1, bo działamy za HTTPS przez Caddy).
DJANGO_SECURE_COOKIES=1
DJANGO_SSL_REDIRECT=1

# Jedno proxy (Caddy) przed aplikacją — IP klienta do limitu i dziennika logowań.
DJANGO_TRUSTED_PROXY_COUNT=1

# --- Konto administratora (tworzone automatycznie przy 1. starcie) ----------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=YOUR_DJANGO_SUPERUSER_PASSWORD_HERE
DJANGO_SUPERUSER_EMAIL=YOUR_DJANGO_SUPERUSER_EMAIL_HERE

# --- Alert e-mail o błędzie 500 (US-021; puste DJANGO_ADMINS = wyłączony) ----
DJANGO_ADMINS=
DJANGO_SERVER_EMAIL=mini-wms@localhost
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1

# --- Baza danych (PostgreSQL w kontenerze) ----------------------------------
POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# --- Backup bazy ------------------------------------------------------------
# Co ile sekund robić kopię (86400 = co 24h). Ile dni trzymać kopie.
BACKUP_INTERVAL=86400
BACKUP_KEEP_DAYS=7

DJANGO_TIME_ZONE=Europe/Warsaw
