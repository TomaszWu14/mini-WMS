# Skopiuj do .env i dostosuj. Zmienne są opcjonalne (mają domyślne wartości).

# Klucz produkcyjny (wygeneruj własny!)
# DJANGO_SECRET_KEY=YOUR_DJANGO_SECRET_KEY_HERE

# Tryb debug (1/0)
DJANGO_DEBUG=1

# Dozwolone hosty, oddzielone przecinkami
DJANGO_ALLOWED_HOSTS=*

# Strefa czasowa
DJANGO_TIME_ZONE=Europe/Warsaw

# Baza danych — domyślnie SQLite. Aby użyć PostgreSQL, odkomentuj:
# DATABASE_URL=YOUR_DATABASE_URL_HERE

# Zaufane origins dla CSRF (gdy za reverse-proxy/HTTPS), np.:
# DJANGO_CSRF_TRUSTED_ORIGINS=YOUR_DJANGO_CSRF_TRUSTED_ORIGINS_HERE
